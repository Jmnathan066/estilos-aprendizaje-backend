APP_NAME="Estilos de Aprendizaje API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=estilos_aprendizaje
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack

# URL(s) del FrontEnd permitidas (coma). En local: Vite
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Profesor inicial (php artisan db:seed)
PROFESOR_USER=profesor
PROFESOR_PASS=cambia-esta-clave

# En Render pon DB_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require (Neon, gratis permanente)

# Correo en LOCAL (Gmail SMTP). En Render usa BREVO_API_KEY (Render gratis bloquea SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Estilos de Aprendizaje"
BREVO_API_KEY=

# Opción SMTP en Render (sin API): Brevo por puerto 2525 (Render gratis solo bloquea 25/465/587)
# MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=2525  MAIL_USERNAME=<login SMTP de Brevo>  MAIL_PASSWORD=<clave SMTP>  (y deja BREVO_API_KEY vacío)
